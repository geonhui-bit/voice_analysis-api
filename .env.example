# HuggingFace 토큰 (pyannote 화자분리용)
HF_AUTH_TOKEN=hf_your_token_here

# WhisperX 설정
WHISPERX_MODEL=large-v3-turbo
WHISPERX_LANGUAGE=ko
WHISPERX_BATCH_SIZE=16

# 포트 설정
API_PORT=9002
REDIS_PORT=6382
CELERY_BROKER_URL=redis://127.0.0.1:6382/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6382/1

# 분석 활성화 플래그
EMOTION_ANALYSIS_ENABLED=true
PROSODY_ANALYSIS_ENABLED=true

# danger: 화자당 운율 급변 N회 이상일 때만 '급변 다발' 플래그 (기본 7)
PROSODY_DANGER_SUDDEN_MIN=7

# STT 후처리: 병합 최대 갭(초), 장세그먼트 분할(초), 공백환각 제거
STT_MAX_MERGE_GAP_SEC=30
STT_MAX_SEGMENT_SEC=90
STT_SPARSE_MIN_DURATION_SEC=45
STT_SPARSE_MAX_CHARS_PER_SEC=1.2
STT_GAP_LOG_SEC=90

# LLM 설정
LLM_BASE_URL=http://localhost:2000
LLM_MODEL=/models/models/gemma-4-31B-it-AWQ-4bit
LLM_MAX_TOKENS=4096
LLM_EMOTION_MAX_TOKENS=2048

# GitHub (로컬 push용, 선택 — git credential/gh auth 권장)
# github_token=ghp_your_token_here
