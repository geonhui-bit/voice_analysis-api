# HuggingFace 토큰 (pyannote 화자분리용)
HF_AUTH_TOKEN=hf_your_token_here

# WhisperX 설정
WHISPERX_MODEL=large-v3-turbo
WHISPERX_LANGUAGE=ko
WHISPERX_BATCH_SIZE=16

# 포트 설정
API_PORT=9002
REDIS_PORT=6382
CELERY_BROKER_URL=redis://127.0.0.1:6382/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6382/1

# 분석 활성화 플래그
EMOTION_ANALYSIS_ENABLED=true
PROSODY_ANALYSIS_ENABLED=true

# LLM 설정
LLM_BASE_URL=http://localhost:2000
LLM_MODEL=/models/models/gemma-4-31B-it-AWQ-4bit
LLM_MAX_TOKENS=4096
